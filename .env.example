# --- Telegram core (https://my.telegram.org) ---
API_ID=1234567
API_HASH=your_api_hash_here
BOT_TOKEN=123456:ABC-your-bot-token

# --- Access control ---
OWNER_ID=123456789
ADMINS=123456789 987654321

# --- Storage: private channel id (bot must be admin) ---
STORAGE_CHANNEL=-1001234567890

# --- Force subscribe (0 = disabled; bot must be admin in the channel) ---
FORCE_SUB_CHANNEL=0

# --- Database (MongoDB Atlas free tier works great) ---
DB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=filestorebot

# --- Behaviour ---
PROTECT_CONTENT=False
ALLOW_CLONE=True
